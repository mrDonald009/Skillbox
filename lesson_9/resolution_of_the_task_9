1. Решение 
1. 
    select 
        * 
    from employee t
        inner join age_range t1
            on t.age_range_id = t1.age_range_id;
2. 
    select 
        * 
    from employee t
        inner join gender t1
            on t.gender_id = t1.gender_id;            
3. 
    select 
        *
    from employee t
        inner join department t1
            on t.department_id = t1.department_id;
4. 
    select 
        * 
    from employee t
        left join department t1
            on t.department_id = t1.department_id;       