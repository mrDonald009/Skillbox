2. Решение
1. 
    select
        distinct country
    from skill_market;
2. 
    select
        distinct country, city
    from skill_market;
3. 
    select
        count(distinct article)
    from skill_market;
4. 
    select
        sum(cnt)
        ,sum(cnt * price) 
    from skill_market
    where (1=1)
            and category = 'computer';
5. 
    select 
        sum(cnt)
        ,sum(cnt * price)
    from skill_market
    where (1=1)
            and office_name like 'N:2%';

3. Решение
1.
    select
        name
        ,count(*) cnt
    from skill_market
    group by name;
2. 
    select
        name 
        ,sum(cnt) cnt 
        ,round(avg(price), 2) avg_price
    from skill_market
    group by name;
3.
    select 
        article
        ,category
        ,sum(price * cnt) total
    from skill_market
    group by category, article
    order by category;
4. 
    select 
        name
        ,count(*) cnt
        ,sum(price * cnt) total
        ,country
        ,city
    from skill_marekt
    group by name, country, city;

5. Решение
1. 
    select
       cast(sale_dt as date) sale_dt
      ,sum(cnt) cnt
      ,sum(price_usd * currency_rate) total_rub
    from skill_sales
    where (1=1) 
            and format(cast(sale_dt as date), 'yyyy-MM') = '2020-01'
    group by sale_dt
    order by sale_dt;
