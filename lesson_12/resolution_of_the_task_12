1. Решение
1.
    select 
        *
        ,row_number() over() as num 
    from skill_market;
2. 
    select 
        *
        ,row_number() over(order by cnt) as num 
    from skill_market 
    order by cnt;
3. 
    select 
        *
        ,row_number() over(order by cnt) as num
        ,row_number() over(order by country, city, office_name, price) as num_2
    from skill_market
    order by country, city, office_name, price;
4. 
    select
        *
        ,row_number() over() as num1
        ,count(*) over() as total_rows
        ,sum(cnt) over() as total_cnt
        ,sum(price * cnt) over() as total
    from skill_market;

2. Решение
1.
    select 
        *
        ,row_number() over(partition by city) as num
    from skill_market;
2.
    select 
        * 
        ,row_number() over(partition by office_type, name) as num 
    from skill_market 
    order by num;
3. 
    select 
        * 
        ,row_number() over(partition by office_name order by cnt) as num1
        ,row_number() over(partition by office_name order by cnt desc) as num2
    from skill_market;
4. 
    select 
        *
        ,row_number() over(partition by city) as num1
        ,count(*) over(partition by city) as total_rows
        ,sum(cnt) over(partition by city) as total_cnt
        ,sum(cnt*price) over (partition by city) as total
    from skill_market;

3. Решение
1. 
    select
        *
        ,sum(cnt*price) over(partition by name order by article) as total_sum
    from skill_market;
2.
    select
        *   
        ,sum(cnt*price) over(partition by name order by article rows between current row and unbounded following) as total_sum
    from skill_market;
3. 
    select
        *   
        ,sum(cnt*price) over(partition by name order by article rows between current row and 1 following) as total_sum
    from skill_market;

4. Решение 
1.
    select 
        *
        ,first_value(seller_uid) over(partition by lot_uid order by bid_time) as seller_uid
    from skill_bids
    order by lot_uid, bid_time;
2. 
    select 
        *
        ,max(rate) over(partition by lot_uid) as max_rate
    from skill_bids
    order by lot_uid, bid_time;
3. 
    select 
        *
        ,bid_time - first_value(bid_time) over(partition by lot_uid order by bid_time) as diff_time
    from skill_bids
    order by lot_uid, bid_time;

